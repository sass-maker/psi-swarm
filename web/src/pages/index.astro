---
import '../styles/global.css';
import RunDashboard from '../components/RunDashboard.tsx';
import PublicRouteHead from '../components/PublicRouteHead.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <PublicRouteHead route="home" />
  </head>
  <body class="min-h-screen">
    <main class="max-w-5xl mx-auto px-6 py-10">
      <header class="mb-10 flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
        <div class="min-w-0">
          <h1 class="text-3xl font-bold tracking-tight">
            <span class="text-[var(--color-cyan)]">psi</span>-swarm
          </h1>
          <p class="text-[var(--color-dim)] mt-1 text-sm">
            Lighthouse, run many times across realistic presets. The shape of your perf, not one noisy point.
          </p>
        </div>
        <nav class="grid w-full grid-cols-3 items-center gap-x-4 gap-y-1 sm:flex sm:flex-wrap sm:gap-x-5 lg:w-auto lg:shrink-0 lg:flex-nowrap lg:justify-end" aria-label="Primary">
          <a href="./projects/" class="inline-flex min-h-11 min-w-11 items-center text-sm text-[var(--color-dim)] hover:text-[var(--color-text)] transition">
            projects
          </a>
          <a href="./compare/" class="inline-flex min-h-11 min-w-11 items-center text-sm text-[var(--color-dim)] hover:text-[var(--color-text)] transition">
            compare
          </a>
          <a href="./watchlist/" class="inline-flex min-h-11 min-w-11 items-center text-sm text-[var(--color-dim)] hover:text-[var(--color-text)] transition">
            watchlist
          </a>
          <a href="./gallery/" class="inline-flex min-h-11 min-w-11 items-center text-sm text-[var(--color-dim)] hover:text-[var(--color-text)] transition">
            gallery
          </a>
          <a href="/changelog" class="inline-flex min-h-11 min-w-11 items-center text-sm text-[var(--color-dim)] hover:text-[var(--color-text)] transition">
            changelog
          </a>
        </nav>
      </header>
      <RunDashboard client:load />
    </main>
    <script
      is:inline
      src="https://sassmaker.com/project-strip.js"
      data-project="psi-swarm"
      defer
    ></script>
  </body>
</html>
